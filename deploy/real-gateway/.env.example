# Allow previously unknown HTTPS application Origins to request gateway-owned
# consent. Approval binds the grant to the exact Origin, app id, callback, and
# tool snapshot. Set to 0 only when using the optional static allowlist below.
AGENT_CONNECT_DYNAMIC_APP_ENROLLMENT=1

# Optional defense-in-depth allowlist when dynamic enrollment is disabled.
AGENT_CONNECT_ALLOWED_ORIGINS=

# HTTPS endpoint created by Tailscale Serve for this gateway.
AGENT_CONNECT_PUBLIC_ENDPOINT=https://your-machine.your-tailnet.ts.net:8443

# Exact Tailscale login allowed to operate this private gateway.
AGENT_CONNECT_ALLOWED_TAILSCALE_USERS=you@example.com

# Isolated runtime state/config; startup links auth.json from the machine login.
# Must differ from the source auth home. Do not perform a second runtime login.
CODEX_HOME=/absolute/path/to/agent-connect-codex-home

# Optional machine login source, default $HOME/.codex before HOME isolation.
# Must contain file-backed auth.json; never defaults to runtime CODEX_HOME.
# AGENT_CONNECT_CODEX_AUTH_HOME=/absolute/path/to/machine-codex-home

# Session working directory. This bounds writes in agent mode, but is not a
# confidentiality boundary from other files readable by the gateway OS user.
AGENT_CONNECT_WORKSPACE=/absolute/path/to/agent-connect-workspace

# Codex ACP mode: read-only (default), agent (workspace-write), or
# agent-full-access. Keep read-only for arbitrary authorized applications.
INITIAL_AGENT_MODE=read-only

# Per-run overrides merged over CODEX_HOME/config.toml by codex-acp. Keep
# approvals owned by the operator rather than an automatic reviewer. The launcher
# enforces cli_auth_credentials_store=file at CLI startup and session creation,
# and rejects keyring/auto overrides.
CODEX_CONFIG='{"approvals_reviewer":"user"}'

# Optional overrides.
# AGENT_CONNECT_STATE_DIR=/absolute/path/to/private-gateway-state
# AGENT_CONNECT_GATEWAY_PORT=8787
# OMNIGENT_PORT=6767
