{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "replace-with-the-same-private-token-as-OPENCLAW_TOKEN"
    },
    "reload": { "mode": "off" },
    "http": { "endpoints": { "responses": { "enabled": true } } }
  },
  "auth": {
    "profiles": { "openai:default": { "provider": "openai", "mode": "oauth" } },
    "order": { "openai": ["openai:default"] }
  },
  "agents": {
    "defaults": {
      "skipBootstrap": true,
      "heartbeat": { "every": "0m" },
      "timeoutSeconds": 90,
      "models": {
        "openai/gpt-5.6-sol": { "agentRuntime": { "id": "openclaw" } }
      }
    },
    "entries": {
      "agent-connect-app-only": {
        "workspace": "/absolute/private/empty-agent-connect-workspace",
        "contextInjection": "never",
        "skills": [],
        "memory": { "search": { "enabled": false } },
        "model": { "primary": "openai/gpt-5.6-sol", "fallbacks": [] },
        "tools": { "deny": ["*"] }
      }
    }
  },
  "tools": {
    "toolSearch": false,
    "elevated": { "enabled": false }
  },
  "plugins": {
    "slots": { "memory": "none" },
    "entries": { "memory-core": { "enabled": false } }
  }
}
