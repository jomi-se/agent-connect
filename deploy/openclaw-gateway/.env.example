# Node dotenv format, not shell. Use literal absolute paths: no $HOME, ~,
# command substitution, shell expansion, or inherited shell profile assumptions.
# Store outside the checkout or in deploy/openclaw-gateway/.env; chmod 600.

# Dedicated operator-selected upstream; never send its token to applications.
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=replace-with-private-upstream-owner-token
OPENCLAW_AGENT_ID=main

# Existing identity preserves grants. For a NEW profile only, run initialize once.
AGENT_CONNECT_STATE_PATH=/absolute/private/agent-connect/connector.json
AGENT_CONNECT_RESPONSE_STATE_PATH=/absolute/private/agent-connect/openclaw-responses
AGENT_CONNECT_HOST=127.0.0.1
AGENT_CONNECT_PORT=8787
AGENT_CONNECT_PUBLIC_ENDPOINT=https://your-machine.your-tailnet.ts.net:8443
AGENT_CONNECT_TRANSPORT_PROFILE=tailscale-serve
AGENT_CONNECT_ALLOWED_TAILSCALE_USERS=you@example.com
AGENT_CONNECT_DYNAMIC_APP_ENROLLMENT=1
AGENT_CONNECT_ALLOWED_ORIGINS=
