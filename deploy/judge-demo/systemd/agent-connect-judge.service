[Unit]
Description=Agent Connect public judge demo and Tailscale Funnel
Requires=docker.service tailscaled.service
After=network-online.target docker.service tailscaled.service
Wants=network-online.target
PartOf=tailscaled.service
ConditionPathExists=/home/dev/agent-connect/deploy/judge-demo/.env

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/dev/agent-connect
ExecStart=/usr/bin/docker compose --env-file /home/dev/agent-connect/deploy/judge-demo/.env -f /home/dev/agent-connect/deploy/judge-demo/compose.yaml up -d --wait --wait-timeout 60
ExecStartPost=/usr/bin/tailscale funnel --bg --yes --https=10000 http://127.0.0.1:10081
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120

[Install]
WantedBy=tailscaled.service
