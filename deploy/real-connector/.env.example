# Allow previously unknown HTTPS application Origins to request connector-owned
# consent. Approval binds the grant to the exact Origin, app id, callback, and
# tool snapshot. Set to 0 only when using the optional static allowlist below.
AGENT_CONNECT_DYNAMIC_APP_ENROLLMENT=1

# Optional defense-in-depth allowlist when dynamic enrollment is disabled.
AGENT_CONNECT_ALLOWED_ORIGINS=

# HTTPS endpoint created by Tailscale Serve for this connector.
AGENT_CONNECT_PUBLIC_ENDPOINT=https://your-machine.your-tailnet.ts.net:8443

# Exact Tailscale login allowed to operate this private connector.
AGENT_CONNECT_ALLOWED_TAILSCALE_USERS=you@example.com

# Dedicated Codex home. Run `CODEX_HOME=<this path> codex login` before startup.
CODEX_HOME=/absolute/path/to/agent-connect-codex-home

# Session working directory. This bounds writes in agent mode, but is not a
# confidentiality boundary from other files readable by the connector OS user.
AGENT_CONNECT_WORKSPACE=/absolute/path/to/agent-connect-workspace

# Codex ACP mode: read-only (default), agent (workspace-write), or
# agent-full-access. Keep read-only for arbitrary authorized applications.
INITIAL_AGENT_MODE=read-only

# Per-run overrides merged over CODEX_HOME/config.toml by codex-acp. Keep
# approvals owned by the operator rather than an automatic reviewer.
CODEX_CONFIG='{"approvals_reviewer":"user"}'

# Optional overrides.
# AGENT_CONNECT_STATE_DIR=/absolute/path/to/private-connector-state
# AGENT_CONNECT_GATEWAY_PORT=8787
# OMNIGENT_PORT=6767
# AGENT_CONNECT_ENROLLMENT_PASSPHRASE=use-a-password-manager-generated-secret
