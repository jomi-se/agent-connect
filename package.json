{
  "name": "agent-connect",
  "version": "0.0.0",
  "private": true,
  "description": "Browser SDK bridge for user-owned agent runtimes",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "analyze": "npm run lint && npm run analyze:dependencies && npm run analyze:dead-code && npm run analyze:duplicates",
    "analyze:dead-code": "knip --no-exit-code",
    "analyze:dependencies": "depcruise packages",
    "analyze:duplicates": "jscpd packages",
    "build": "npm run build --workspace @open-agent-connect/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "security:hooks:install": "./scripts/install-git-hooks.sh",
    "security:scan": "./scripts/scan-secrets.sh history",
    "test": "npm run test --workspaces --if-present && node --test scripts/test-fixture-cleanup.test.mjs scripts/release.test.mjs scripts/release-build-env.test.mjs",
    "test:package:web": "node scripts/smoke-web-sdk-package.mjs",
    "test:webmcp": "npm run test:webmcp --workspace @open-agent-connect/web",
    "pretypecheck": "npm run build --workspace @open-agent-connect/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run format:check && npm run typecheck && npm run test:docs && npm test && npm run build && npm run test:ui:owner && npm run test:integration:gateway && npm run test:integration:gateway:boxed && npm run test:integration:gateway:teardown && npm run test:integration:gateway:clean-room",
    "verify:full": "npm run verify && npm run test:package:web && npm run test:webmcp",
    "test:integration:gateway": "node scripts/gateway-scenarios.mjs",
    "test:integration:gateway:boxed": "ACP_BOXED=1 ACP_SCENARIOS=tools,policy,use-chat,shell,cancel,resume,slow-cut,ask-cut,answer-halfopen,expire,discard node scripts/gateway-scenarios.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:prepare-local": "node scripts/build-release-local.mjs",
    "release:dry-run": "node scripts/release.mjs publish-dry-run",
    "build:box-runners": "./deploy/gateway/box/build-local.sh",
    "test:integration:gateway:clean-room": "node scripts/clean-room.mjs",
    "test:integration:gateway:teardown": "node scripts/gateway-teardown.mjs",
    "test:ui:owner": "node scripts/owner-ui.mjs",
    "test:docs": "node scripts/check-readme-snippets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "dependency-cruiser": "18.4.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "globals": "17.12.0",
    "jscpd": "5.3.2",
    "knip": "6.38.0",
    "openai": "7.23.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11",
    "ws": "8.22.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0"
  }
}
