{
  "name": "agent-connect",
  "version": "0.0.0",
  "private": true,
  "description": "Browser SDK bridge for user-owned agent runtimes",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "analyze": "npm run lint && npm run analyze:dependencies && npm run analyze:dead-code && npm run analyze:duplicates",
    "analyze:dead-code": "knip --no-exit-code",
    "analyze:dependencies": "depcruise packages",
    "analyze:duplicates": "jscpd packages",
    "build": "npm run build --workspace @open-agent-connect/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "security:hooks:install": "./scripts/install-git-hooks.sh",
    "security:scan": "./scripts/scan-secrets.sh history",
    "test": "npm run test --workspaces --if-present && node --test scripts/test-fixture-cleanup.test.mjs scripts/acp-release.test.mjs",
    "test:package:web": "node scripts/smoke-web-sdk-package.mjs",
    "test:webmcp": "npm run test:webmcp --workspace @open-agent-connect/web",
    "pretypecheck": "npm run build --workspace @open-agent-connect/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run build && npm run test:ui:acp-owner && npm run test:integration:acp && npm run test:integration:acp:boxed && npm run test:integration:acp:teardown && npm run test:integration:acp:clean-room",
    "verify:full": "npm run verify && npm run test:package:web && npm run test:webmcp",
    "test:integration:acp": "node scripts/acp-gateway-scenarios.mjs",
    "test:integration:acp:boxed": "ACP_BOXED=1 ACP_SCENARIOS=tools,policy,use-chat,shell,cancel,resume,slow-cut,ask-cut,answer-halfopen,expire,discard node scripts/acp-gateway-scenarios.mjs",
    "release:acp:check": "node scripts/acp-release.mjs check",
    "release:acp:prepare-local": "node scripts/build-acp-release-local.mjs",
    "release:acp:dry-run": "node scripts/acp-release.mjs publish-dry-run",
    "build:acp:session": "./deploy/acp-gateway/session/build-local.sh",
    "test:integration:acp:clean-room": "node scripts/acp-clean-room.mjs",
    "test:integration:acp:teardown": "node scripts/acp-gateway-teardown.mjs",
    "test:ui:acp-owner": "node scripts/acp-owner-ui.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "dependency-cruiser": "18.1.0",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "globals": "17.7.0",
    "jscpd": "5.0.12",
    "knip": "6.27.0",
    "openai": "7.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0"
  }
}
