@@ -0,0 +1,96 @@
+import { describe, expect, it } from "vitest";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import {
+  fingerprintOpenResponsesApplicationPolicy,
+  resolveOpenResponsesApplicationPolicy,
+} from "./openresponses-application-policy.js";
+
+function config(): OpenClawConfig {
+  return {
+    gateway: {
+      roles: {
+        definitions: {
+          delegated: {
+            sessions: { others: "none" },
+            agents: ["application-agent"],
+            scopes: ["operator.write"],
+            sandbox: "required",
+          },
+        },
+      },
+    },
+    agents: {
+      defaults: { sandbox: { mode: "all" } },
+      list: [
+        {
+          id: "application-agent",
+          workspace: "/srv/openclaw-apps/application-agent",
+          contextInjection: "never",
+          tools: { allow: ["web_search"] },
+        },
+      ],
+    },
+    tools: { allow: ["web_search", "exec"] },
+  };
+}
+
+const integration = { pluginId: "delegation-plugin", pluginVersion: "1.0.0" };
+
+describe("OpenResponses delegated execution policy revision", () => {
+  it("changes whenever the effective agent or native tool configuration changes", () => {
+    const before = config();
+    const after = config();
+    after.tools = { allow: ["web_search", "exec", "read"] };
+    const revision = fingerprintOpenResponsesApplicationPolicy(before, "delegated", integration);
+    expect(revision).toMatch(/^sha256:/);
+    expect(fingerprintOpenResponsesApplicationPolicy(after, "delegated", integration)).not.toBe(
+      revision,
+    );
+  });
+
+  it("requires a non-admin role closed to exactly one real agent", () => {
+    const missingRole = config();
+    delete missingRole.gateway?.roles;
+    expect(
