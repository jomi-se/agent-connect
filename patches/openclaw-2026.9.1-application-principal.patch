@@ -0,0 +1,31 @@
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import { fingerprintOpenResponsesApplicationPolicy as fingerprintPolicy } from "../gateway/openresponses-application-policy.js";
+import { getPluginRegistrationContext } from "../plugins/runtime.js";
+import { getPluginRuntimeGatewayRequestScope } from "../plugins/runtime/gateway-request-scope.js";
+import type { OpenClawOpenResponsesNativeCapability } from "../plugins/types.js";
+
+export type { ResolvedOpenResponsesApplicationPolicy } from "../gateway/openresponses-application-policy.js";
+
+/** Fingerprint live native policy under the calling plugin's pinned identity. */
+export function fingerprintOpenResponsesApplicationPolicy(
+  cfg: OpenClawConfig,
+  params: {
+    policyRef: string;
+    agentId: string;
+    nativeCapabilities: readonly OpenClawOpenResponsesNativeCapability[];
+  },
+): string | undefined {
+  const registration = getPluginRegistrationContext();
+  const scope = getPluginRuntimeGatewayRequestScope();
+  const pluginId = registration?.pluginId ?? scope?.pluginId;
+  if (!pluginId) {
+    return undefined;
+  }
+  const registry = registration?.registry ?? scope?.pluginRegistry;
+  const plugin = registry?.plugins.find((candidate) => candidate.id === pluginId);
+  const pluginVersion = registration?.pluginVersion ?? plugin?.version;
+  return fingerprintPolicy(cfg, params.policyRef, params.agentId, params.nativeCapabilities, {
+    pluginId,
+    ...(pluginVersion ? { pluginVersion } : {}),
+  });
+}
