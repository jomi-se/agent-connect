--- /dev/null
+++ b/src/plugin-sdk/authenticated-http-principal.ts
@@ -0,0 +1,39 @@
+import type { IncomingMessage } from "node:http";
+import { authenticateVerifiedHttpPrincipalRequest } from "../gateway/http-auth-utils.js";
+import { getPluginRuntimeGatewayRequestScope } from "../plugins/runtime/gateway-request-scope.js";
+
+export type AuthenticatedPluginHttpPrincipal = {
+  profileId: string;
+  scopes: readonly string[];
+};
+
+export type VerifiedPluginHttpPrincipal = AuthenticatedPluginHttpPrincipal & {
+  authMethod: "tailscale";
+};
+
+/**
+ * Returns only host-verified durable identity from an authenticated plugin HTTP
+ * route. Callers still enforce their own authorization and request-integrity policy.
+ */
+export function getAuthenticatedPluginHttpPrincipal():
+  | AuthenticatedPluginHttpPrincipal
+  | undefined {
+  const client = getPluginRuntimeGatewayRequestScope()?.client;
+  const profileId = client?.authenticatedUserProfile?.profileId;
+  if (!profileId || client?.internal?.syntheticClient) {
+    return undefined;
+  }
+  return { profileId, scopes: [...(client.connect.scopes ?? [])] };
+}
+
+/**
+ * Authenticates the actual listener-bound request using only an explicitly
+ * accepted host method. Reachability or forwarded identity headers are never
+ * authentication. The v0 method set contains managed Tailscale WhoIs only.
+ */
+export async function authenticateVerifiedPluginHttpPrincipal(
+  req: IncomingMessage,
+  options: { authMethods: readonly ["tailscale"] },
+): Promise<VerifiedPluginHttpPrincipal | undefined> {
+  return await authenticateVerifiedHttpPrincipalRequest(req, options);
+}
