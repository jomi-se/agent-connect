+              displayName: null,
+              hasAvatar: false,
+              updatedAt: 1,
+            },
+          }
+        : {}),
+      connect: {
+        minProtocol: PROTOCOL_VERSION,
+        maxProtocol: PROTOCOL_VERSION,
+        client: { id: "gateway-client", version: "test", platform: "node", mode: "backend" },
+        role: "operator",
+        scopes: ["operator.admin"],
+      },
+    },
+  } as Parameters<typeof withPluginRuntimeGatewayRequestScope>[0];
+}
+
+describe("authenticated plugin HTTP principal", () => {
+  it("returns a host-resolved durable profile and scopes", () => {
+    withPluginRuntimeGatewayRequestScope(scope("profile-owner"), () => {
+      expect(getAuthenticatedPluginHttpPrincipal()).toEqual({
+        profileId: "profile-owner",
+        scopes: ["operator.admin"],
+      });
+    });
+  });
+
+  it("does not turn an unprofiled shared-secret owner into a consent identity", () => {
+    withPluginRuntimeGatewayRequestScope(scope(), () => {
+      expect(getAuthenticatedPluginHttpPrincipal()).toBeUndefined();
+    });
+  });
+});
diff --git a/src/plugin-sdk/authenticated-http-principal.ts b/src/plugin-sdk/authenticated-http-principal.ts
new file mode 100644
index 0000000..6908800
--- /dev/null
+++ b/src/plugin-sdk/authenticated-http-principal.ts
@@ -0,0 +1,36 @@
+import type { IncomingMessage } from "node:http";
+import { authenticateManagedTailscaleOwnerConsentRequest } from "../gateway/http-auth-utils.js";
+import { getPluginRuntimeGatewayRequestScope } from "../plugins/runtime/gateway-request-scope.js";
+
+export type AuthenticatedPluginHttpPrincipal = {
+  profileId: string;
+  scopes: readonly string[];
+};
+
+/**
+ * Returns only host-verified durable identity from an authenticated plugin HTTP
+ * route. Callers still enforce their configured owner allowlist and admin scope.
+ */
+export function getAuthenticatedPluginHttpPrincipal():
+  | AuthenticatedPluginHttpPrincipal
+  | undefined {
+  const client = getPluginRuntimeGatewayRequestScope()?.client;
+  const profileId = client?.authenticatedUserProfile?.profileId;
+  if (!profileId || client?.internal?.syntheticClient) {
+    return undefined;
+  }
+  return { profileId, scopes: [...(client.connect.scopes ?? [])] };
+}
+
+/**
+ * Verifies managed-Tailscale ingress for one plugin-owned consent request.
+ * Callers still require admin scope, their owner allowlist, Origin, and CSRF.
+ */
+export async function authenticateManagedTailscaleOwnerConsent(
+  req: IncomingMessage,
+): Promise<AuthenticatedPluginHttpPrincipal | undefined> {
+  if (!getPluginRuntimeGatewayRequestScope()?.pluginId) {
+    return undefined;
+  }
+  return await authenticateManagedTailscaleOwnerConsentRequest(req);
+}
