diff --git a/src/gateway/openresponses-application-auth.ts b/src/gateway/openresponses-application-auth.ts
new file mode 100644
index 0000000..4a95a07
--- /dev/null
+++ b/src/gateway/openresponses-application-auth.ts
@@ -0,0 +1,152 @@
+import type { IncomingMessage, ServerResponse } from "node:http";
+import { normalizeOptionalString } from "@openclaw/normalization-core/string-coerce";
+import { getOpenResponsesApplicationAuthRegistration } from "../plugins/runtime.js";
+import type {
+  OpenClawOpenResponsesApplicationAuthProvider,
+  OpenClawOpenResponsesApplicationPrincipal,
+} from "../plugins/types.js";
+import { ensureProfileForApplicationPrincipal } from "../state/user-profiles.js";
+import type { AuthorizedGatewayHttpRequest } from "./http-auth-utils.js";
+import { sendJson } from "./http-common.js";
+import { resolveOpenResponsesApplicationPolicy } from "./openresponses-application-policy.js";
+
+type CorsGrant = { origin: string; allowHeaders: readonly string[] };
+
+export type AuthorizedOpenResponsesApplicationRequest = {
+  provider: OpenClawOpenResponsesApplicationAuthProvider;
+  principal: OpenClawOpenResponsesApplicationPrincipal;
+  requestAuth: AuthorizedGatewayHttpRequest;
+};
+
+export type OpenResponsesApplicationAuthDecision =
+  | { status: "pass" }
+  | { status: "handled" }
+  | ({ status: "authorized" } & AuthorizedOpenResponsesApplicationRequest);
+
+function applyCors(res: ServerResponse, cors: CorsGrant): void {
+  res.setHeader("access-control-allow-origin", cors.origin);
+  res.setHeader("access-control-allow-methods", "POST, OPTIONS");
+  res.setHeader("access-control-allow-headers", cors.allowHeaders.join(", "));
+  res.setHeader("vary", "Origin");
+}
+
+async function authorizeCors(params: {
+  req: IncomingMessage;
+  res: ServerResponse;
+  provider: OpenClawOpenResponsesApplicationAuthProvider;
+}): Promise<boolean> {
+  const origin = normalizeOptionalString(params.req.headers.origin);
+  if (!origin) {
+    return true;
+  }
+  const cors = await params.provider.resolveBrowserOrigin?.(params.req);
+  if (!cors || cors.origin !== origin) {
+    sendJson(params.res, 403, { error: { message: "origin forbidden", type: "forbidden" } });
+    return false;
+  }
+  const requestedHeaders = normalizeOptionalString(
+    params.req.headers["access-control-request-headers"],
+  )
+    ?.split(",")
+    .map((header) => header.trim().toLowerCase())
+    .filter(Boolean);
+  const allowed = new Set(cors.allowHeaders.map((header) => header.trim().toLowerCase()));
+  if (requestedHeaders?.some((header) => !allowed.has(header))) {
+    sendJson(params.res, 403, { error: { message: "headers forbidden", type: "forbidden" } });
+    return false;
+  }
+  applyCors(params.res, cors);
+  return true;
+}
+
+/** Runs before stock Gateway auth so a plugin credential never becomes a shared operator token. */
+export async function authorizeOpenResponsesApplicationRequest(params: {
+  req: IncomingMessage;
+  res: ServerResponse;
+}): Promise<OpenResponsesApplicationAuthDecision> {
+  const registration = getOpenResponsesApplicationAuthRegistration();
+  if (!registration) {
+    return { status: "pass" };
+  }
+  if (params.req.method === "OPTIONS") {
+    if (
+      normalizeOptionalString(
+        params.req.headers["access-control-request-method"],
+      )?.toUpperCase() !== "POST"
+    ) {
+      sendJson(params.res, 405, { error: { message: "method forbidden", type: "forbidden" } });
+      return { status: "handled" };
+    }
+    if (!(await authorizeCors({ ...params, provider: registration.provider }))) {
+      return { status: "handled" };
+    }
+    params.res.writeHead(204);
+    params.res.end();
+    return { status: "handled" };
+  }
+  const auth = await registration.provider.authenticate(params.req);
+  if (auth.status === "pass") {
+    return { status: "pass" };
+  }
+  if (!(await authorizeCors({ ...params, provider: registration.provider }))) {
+    return { status: "handled" };
+  }
+  if (auth.status === "deny") {
+    sendJson(params.res, 401, { error: { message: "unauthorized", type: "unauthorized" } });
+    return { status: "handled" };
+  }
+  const principal = auth.principal;
+  const cfg = (await import("../config/io.js")).getRuntimeConfig();
+  const policy = resolveOpenResponsesApplicationPolicy({
+    cfg,
+    policyRef: principal.policyRef,
+    agentId: principal.agentId,
+    nativeCapabilities: principal.nativeCapabilities,
+    expectedFingerprint: principal.policyFingerprint,
+    integration: {
+      pluginId: registration.pluginId,
+      ...(registration.pluginVersion ? { pluginVersion: registration.pluginVersion } : {}),
+    },
+  });
+  if (!policy) {
+    sendJson(params.res, 403, {
+      error: { message: "application policy changed or is unavailable", type: "forbidden" },
+    });
+    return { status: "handled" };
+  }
+  try {
+    const profile = ensureProfileForApplicationPrincipal({
+      pluginId: registration.pluginId,
+      subject: principal.subject,
+    });
+    const applicationPrincipal = {
+      pluginId: registration.pluginId,
+      subject: principal.subject,
+      profileId: profile.id,
+      agentId: principal.agentId,
+      policyRef: principal.policyRef,
+      policyFingerprint: principal.policyFingerprint,
+    };
+    return {
+      status: "authorized",
+      provider: registration.provider,
+      principal,
+      requestAuth: {
+        trustDeclaredOperatorScopes: false,
+        authenticatedUserProfile: {
+          profileId: profile.id,
+          displayName: profile.displayName,
+          hasAvatar: Boolean(profile.avatarMime),
+          updatedAt: profile.updatedAt,
+        },
+        operatorRolePolicy: policy.role,
+        applicationPrincipal,
+      },
+    };
+  } catch {
+    sendJson(params.res, 503, {
+      error: { message: "application profile unavailable", type: "server_error" },
+    });
+    return { status: "handled" };
+  }
+}
diff --git a/src/gateway/openresponses-application-policy.test.ts b/src/gateway/openresponses-application-policy.test.ts
new file mode 100644
index 0000000..b4df2d3
--- /dev/null
+++ b/src/gateway/openresponses-application-policy.test.ts
@@ -0,0 +1,123 @@
+import { describe, expect, it } from "vitest";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { OpenClawOpenResponsesNativeCapability } from "../plugins/types.js";
+import { fingerprintOpenResponsesApplicationPolicy } from "./openresponses-application-policy.js";
+
+function config(): OpenClawConfig {
+  return {
+    gateway: {
+      roles: {
+        definitions: {
+          bookhand: {
+            sessions: { others: "none" },
+            agents: ["bookhand"],
+            scopes: ["operator.write"],
+            sandbox: "required",
+          },
+        },
+      },
+    },
+    agents: {
+      defaults: { sandbox: { mode: "all" } },
+      list: [
+        {
+          id: "bookhand",
+          workspace: "/srv/openclaw-apps/bookhand",
+          contextInjection: "never",
+          tools: { allow: ["web_search"] },
+        },
+      ],
+    },
+    tools: { allow: ["web_search", "exec"] },
+  };
+}
+
+const integration = { pluginId: "agent-connect", pluginVersion: "1.0.0" };
+const webSearch = ["public_web_search"] as const;
+
+function fingerprint(
+  config: OpenClawConfig,
+  capabilities: readonly OpenClawOpenResponsesNativeCapability[] = webSearch,
+) {
+  return fingerprintOpenResponsesApplicationPolicy(
+    config,
+    "bookhand",
+    "bookhand",
+    capabilities,
+    integration,
+  );
+}
+
+describe("OpenResponses application policy fingerprint", () => {
+  it("changes when effective native tool policy changes", () => {
+    const before = config();
+    const after = config();
+    after.tools = { allow: ["web_search", "exec", "read"] };
+    expect(fingerprint(before)).toMatch(/^sha256:/);
+    expect(fingerprint(after)).not.toBe(fingerprint(before));
+  });
+
+  it("fails closed without an explicit isolated role and agent", () => {
+    const missingRole = config();
+    delete missingRole.gateway?.roles;
+    expect(fingerprint(missingRole)).toBeUndefined();
+
+    const broad = config();
+    broad.gateway!.roles!.definitions.bookhand = {
+      sessions: { others: "write" },
+      agents: "*",
+      scopes: ["operator.admin"],
+    };
+    expect(fingerprint(broad)).toBeUndefined();
+
+    const implicitAgent = config();
+    implicitAgent.agents!.list = [];
+    expect(fingerprint(implicitAgent)).toBeUndefined();
+  });
+
+  it("requires an exact closed native tool upper bound for advertised capabilities", () => {
+    const noNativeTools = config();
+    noNativeTools.agents!.list![0]!.tools = { deny: ["*"] };
+    expect(fingerprint(noNativeTools, [])).toMatch(/^sha256:/);
+
+    const emptyAllowIsPermissive = config();
+    emptyAllowIsPermissive.agents!.list![0]!.tools = { allow: [] };
+    expect(fingerprint(emptyAllowIsPermissive, [])).toBeUndefined();
+
+    const appToolsWithHostExec = config();
+    appToolsWithHostExec.agents!.list![0]!.tools = { allow: ["exec"] };
+    expect(fingerprint(appToolsWithHostExec, [])).toBeUndefined();
+
+    const missingAllowlist = config();
+    delete missingAllowlist.agents!.list![0]!.tools;
+    expect(fingerprint(missingAllowlist)).toBeUndefined();
+  });
+
+  it("rejects policy layers that remove an advertised native capability", () => {
+    const globalDeny = config();
+    globalDeny.tools = { deny: ["web_search"] };
+    expect(fingerprint(globalDeny)).toBeUndefined();
+
+    const sandboxDeny = config();
+    sandboxDeny.tools = { sandbox: { tools: { deny: ["web_search"] } } };
+    expect(fingerprint(sandboxDeny)).toBeUndefined();
+
+    const providerDependent = config();
+    providerDependent.agents!.list![0]!.tools!.byProvider = {
+      openai: { allow: ["web_search"] },
+    };
+    expect(fingerprint(providerDependent)).toBeUndefined();
+  });
+
+  it("requires sandbox isolation only for native code execution", () => {
+    const webOnly = config();
+    webOnly.gateway!.roles!.definitions.bookhand.sandbox = "inherit";
+    expect(fingerprint(webOnly)).toMatch(/^sha256:/);
+
+    const code = config();
+    code.agents!.list![0]!.tools = { allow: ["process", "exec"] };
+    expect(fingerprint(code, ["sandbox_code_execution"])).toMatch(/^sha256:/);
+    code.gateway!.roles!.definitions.bookhand.sandbox = "inherit";
+    expect(fingerprint(code, ["sandbox_code_execution"])).toBeUndefined();
+  });
+});
diff --git a/src/gateway/openresponses-application-policy.ts b/src/gateway/openresponses-application-policy.ts
new file mode 100644
index 0000000..5a60ca3
--- /dev/null
+++ b/src/gateway/openresponses-application-policy.ts
@@ -0,0 +1,175 @@
+import { createHash } from "node:crypto";
+import { stableStringify } from "@openclaw/normalization-core";
+import { resolveAgentConfig, resolveAgentEntry } from "../agents/agent-scope-config.js";
+import { createToolPolicyMatcher } from "../agents/tool-policy-match.js";
+import type { GatewayOperatorRoleDefinition } from "../config/types.gateway.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { OpenClawOpenResponsesNativeCapability } from "../plugins/types.js";
+import { VERSION } from "../version.js";
+
+export type OpenResponsesApplicationPolicyIntegration = {
+  pluginId: string;
+  pluginVersion?: string;
+};
+
+export type ResolvedOpenResponsesApplicationPolicy = {
+  role: GatewayOperatorRoleDefinition;
+  fingerprint: string;
+};
+
+function getOwnRole(
+  cfg: OpenClawConfig,
+  policyRef: string,
+): GatewayOperatorRoleDefinition | undefined {
+  const definitions = cfg.gateway?.roles?.definitions;
+  return definitions && Object.hasOwn(definitions, policyRef) ? definitions[policyRef] : undefined;
+}
+
+function policyFingerprintPayload(
+  cfg: OpenClawConfig,
+  policyRef: string,
+  agentId: string,
+  role: GatewayOperatorRoleDefinition,
+  nativeCapabilities: readonly OpenClawOpenResponsesNativeCapability[],
+  integration: OpenResponsesApplicationPolicyIntegration,
+) {
+  const agentEntry = resolveAgentEntry(cfg, agentId);
+  const resolvedAgent = resolveAgentConfig(cfg, agentId);
+  return {
+    version: 1,
+    runtimeVersion: VERSION,
+    integration,
+    policyRef,
+    agentId,
+    role,
+    nativeCapabilities,
+    agentEntry: agentEntry ?? null,
+    resolvedAgent: resolvedAgent ?? null,
+    agentDefaults: cfg.agents?.defaults ?? null,
+    tools: cfg.tools ?? null,
+  };
+}
+
+const CAPABILITY_TO_NATIVE_TOOLS: Record<OpenClawOpenResponsesNativeCapability, readonly string[]> =
+  {
+    public_web_search: ["web_search"],
+    sandbox_code_execution: ["exec", "process"],
+  };
+
+function resolveNativeCapabilityPolicy(
+  capabilities: readonly OpenClawOpenResponsesNativeCapability[],
+): { capabilities: OpenClawOpenResponsesNativeCapability[]; tools: string[] } | undefined {
+  const unique = new Set<OpenClawOpenResponsesNativeCapability>();
+  for (const capability of capabilities) {
+    if (!Object.hasOwn(CAPABILITY_TO_NATIVE_TOOLS, capability) || unique.has(capability)) {
+      return undefined;
+    }
+    unique.add(capability);
+  }
+  const normalizedCapabilities = [...unique].sort();
+  return {
+    capabilities: normalizedCapabilities,
+    tools: [
+      ...new Set(normalizedCapabilities.flatMap((item) => CAPABILITY_TO_NATIVE_TOOLS[item])),
+    ].sort(),
+  };
+}
+
+function normalizedPolicyEntries(entries: readonly string[] | undefined): string[] {
+  return [...new Set((entries ?? []).map((entry) => entry.trim()).filter(Boolean))].sort();
+}
+
+function hasExactPolicyEntries(
+  actual: readonly string[] | undefined,
+  expected: readonly string[],
+): boolean {
+  return normalizedPolicyEntries(actual).join("\0") === [...expected].sort().join("\0");
+}
+
+function policyAllowsEvery(
+  policy: { allow?: string[]; deny?: string[] } | undefined,
+  toolNames: readonly string[],
+): boolean {
+  const matches = createToolPolicyMatcher(policy);
+  return toolNames.every((toolName) => matches(toolName));
+}
+
+export function fingerprintOpenResponsesApplicationPolicy(
+  cfg: OpenClawConfig,
+  policyRef: string,
+  agentId: string,
+  nativeCapabilities: readonly OpenClawOpenResponsesNativeCapability[],
+  integration: OpenResponsesApplicationPolicyIntegration,
+): string | undefined {
+  const role = getOwnRole(cfg, policyRef);
+  if (!role || role.sessions.others !== "none" || role.agents === "*") {
+    return undefined;
+  }
+  if (!role.agents.includes(agentId) || role.scopes.includes("operator.admin")) {
+    return undefined;
+  }
+  const agentEntry = resolveAgentEntry(cfg, agentId);
+  const agent = resolveAgentConfig(cfg, agentId);
+  const capabilityPolicy = resolveNativeCapabilityPolicy(nativeCapabilities);
+  const agentTools = agent?.tools;
+  const noNativeTools = capabilityPolicy?.tools.length === 0;
+  if (
+    !agentEntry ||
+    !agent ||
+    !capabilityPolicy ||
+    (!agentEntry.workspace?.trim() && !agentEntry.cwd?.trim()) ||
+    agent.contextInjection !== "never" ||
+    !agentTools ||
+    agentTools.alsoAllow !== undefined ||
+    agentTools.profile !== undefined ||
+    agentTools.byProvider !== undefined ||
+    agentTools.toolsBySender !== undefined ||
+    cfg.tools?.profile !== undefined ||
+    cfg.tools?.byProvider !== undefined ||
+    cfg.tools?.toolsBySender !== undefined ||
+    (noNativeTools
+      ? !hasExactPolicyEntries(agentTools.deny, ["*"])
+      : !hasExactPolicyEntries(agentTools.allow, capabilityPolicy.tools) ||
+        normalizedPolicyEntries(agentTools.deny).length > 0) ||
+    !policyAllowsEvery(cfg.tools, capabilityPolicy.tools) ||
+    !policyAllowsEvery(cfg.tools?.sandbox?.tools, capabilityPolicy.tools) ||
+    !policyAllowsEvery(agentTools.sandbox?.tools, capabilityPolicy.tools) ||
+    (capabilityPolicy.capabilities.includes("sandbox_code_execution") &&
+      role.sandbox !== "required")
+  ) {
+    return undefined;
+  }
+  return `sha256:${createHash("sha256")
+    .update(
+      stableStringify(
+        policyFingerprintPayload(
+          cfg,
+          policyRef,
+          agentId,
+          role,
+          capabilityPolicy.capabilities,
+          integration,
+        ),
+      ),
+    )
+    .digest("base64url")}`;
+}
+
+export function resolveOpenResponsesApplicationPolicy(params: {
+  cfg: OpenClawConfig;
+  policyRef: string;
+  agentId: string;
+  nativeCapabilities: readonly OpenClawOpenResponsesNativeCapability[];
+  expectedFingerprint: string;
+  integration: OpenResponsesApplicationPolicyIntegration;
+}): ResolvedOpenResponsesApplicationPolicy | undefined {
+  const role = getOwnRole(params.cfg, params.policyRef);
+  const fingerprint = fingerprintOpenResponsesApplicationPolicy(
+    params.cfg,
+    params.policyRef,
+    params.agentId,
+    params.nativeCapabilities,
+    params.integration,
+  );
+  return role && fingerprint === params.expectedFingerprint ? { role, fingerprint } : undefined;
+}
