diff --git a/src/gateway/openresponses-application-auth.ts b/src/gateway/openresponses-application-auth.ts
new file mode 100644
index 0000000..61aefde
--- /dev/null
+++ b/src/gateway/openresponses-application-auth.ts
@@ -0,0 +1,191 @@
+import type { IncomingMessage, ServerResponse } from "node:http";
+import { normalizeOptionalString } from "@openclaw/normalization-core/string-coerce";
+import {
+  captureOpenResponsesApplicationAuthRegistration,
+  type CapturedOpenResponsesApplicationAuthRegistration,
+} from "../plugins/runtime.js";
+import type { OpenClawOpenResponsesApplicationPrincipal } from "../plugins/types.js";
+import { ensureProfileForApplicationPrincipal } from "../state/user-profiles.js";
+import type { AuthorizedGatewayHttpRequest } from "./http-auth-utils.js";
+import { sendJson } from "./http-common.js";
+import {
+  resolveOpenResponsesApplicationPolicy,
+  type ResolvedOpenResponsesApplicationPolicy,
+} from "./openresponses-application-policy.js";
+
+type CorsGrant = { origin: string; allowHeaders: readonly string[] };
+
+export type AuthorizedOpenResponsesApplicationRequest = {
+  captured: CapturedOpenResponsesApplicationAuthRegistration;
+  principal: OpenClawOpenResponsesApplicationPrincipal;
+};
+
+export type AdmittedOpenResponsesApplicationRequest = AuthorizedOpenResponsesApplicationRequest & {
+  policy: ResolvedOpenResponsesApplicationPolicy;
+  requestAuth: AuthorizedGatewayHttpRequest;
+};
+
+export type OpenResponsesApplicationAuthDecision =
+  | { status: "pass" }
+  | { status: "handled" }
+  | ({ status: "authorized" } & AuthorizedOpenResponsesApplicationRequest);
+
+function applyCors(res: ServerResponse, cors: CorsGrant): void {
+  res.setHeader("access-control-allow-origin", cors.origin);
+  res.setHeader("access-control-allow-methods", "POST, OPTIONS");
+  res.setHeader("access-control-allow-headers", cors.allowHeaders.join(", "));
+  res.setHeader("vary", "Origin");
+}
+
+function providerUnavailable(res: ServerResponse): void {
+  sendJson(res, 503, {
+    error: { message: "application authorization provider unavailable", type: "server_error" },
+  });
+}
+
+async function authorizeCors(params: {
+  req: IncomingMessage;
+  res: ServerResponse;
+  captured: CapturedOpenResponsesApplicationAuthRegistration;
+}): Promise<boolean> {
+  const origin = normalizeOptionalString(params.req.headers.origin);
+  if (!origin) {
+    return true;
+  }
+  let cors: CorsGrant | null | undefined;
+  try {
+    cors = await params.captured.runInPluginScope(() =>
+      params.captured.registration.provider.resolveBrowserOrigin?.(params.req),
+    );
+  } catch {
+    providerUnavailable(params.res);
+    return false;
+  }
+  if (!params.captured.isCurrent()) {
+    providerUnavailable(params.res);
+    return false;
+  }
+  if (!cors || cors.origin !== origin) {
+    sendJson(params.res, 403, { error: { message: "origin forbidden", type: "forbidden" } });
+    return false;
+  }
+  const requestedHeaders = normalizeOptionalString(
+    params.req.headers["access-control-request-headers"],
+  )
+    ?.split(",")
+    .map((header) => header.trim().toLowerCase())
+    .filter(Boolean);
+  const allowed = new Set(cors.allowHeaders.map((header) => header.trim().toLowerCase()));
+  if (requestedHeaders?.some((header) => !allowed.has(header))) {
+    sendJson(params.res, 403, { error: { message: "headers forbidden", type: "forbidden" } });
+    return false;
+  }
+  applyCors(params.res, cors);
+  return true;
+}
+
+/** Runs before stock Gateway auth so a claimed plugin credential cannot become an operator token. */
+export async function authorizeOpenResponsesApplicationRequest(params: {
+  req: IncomingMessage;
+  res: ServerResponse;
+}): Promise<OpenResponsesApplicationAuthDecision> {
+  const captured = captureOpenResponsesApplicationAuthRegistration();
+  if (!captured) {
+    return { status: "pass" };
+  }
+  if (params.req.method === "OPTIONS") {
+    if (
+      normalizeOptionalString(
+        params.req.headers["access-control-request-method"],
+      )?.toUpperCase() !== "POST"
+    ) {
+      sendJson(params.res, 405, { error: { message: "method forbidden", type: "forbidden" } });
+      return { status: "handled" };
+    }
+    if (!(await authorizeCors({ ...params, captured }))) {
+      return { status: "handled" };
+    }
+    params.res.writeHead(204);
+    params.res.end();
+    return { status: "handled" };
+  }
+  let auth: Awaited<ReturnType<typeof captured.registration.provider.authenticate>>;
+  try {
+    auth = await captured.runInPluginScope(() =>
+      captured.registration.provider.authenticate(params.req),
+    );
+  } catch {
+    providerUnavailable(params.res);
+    return { status: "handled" };
+  }
+  if (auth.status === "pass") {
+    return { status: "pass" };
+  }
+  if (!(await authorizeCors({ ...params, captured }))) {
+    return { status: "handled" };
+  }
+  if (auth.status === "deny") {
+    sendJson(params.res, 401, { error: { message: "unauthorized", type: "unauthorized" } });
+    return { status: "handled" };
+  }
+  if (!captured.isCurrent()) {
+    providerUnavailable(params.res);
+    return { status: "handled" };
+  }
+  return { status: "authorized", captured, principal: auth.principal };
+}
+
+/**
+ * Native execution admission linearizes here. There are no awaits between the
+ * lifecycle check, current config read, revision validation, and immutable
+ * policy capture. Later runtime preparation must consume `policy.config`.
+ */
+export async function admitOpenResponsesApplicationRequest(
+  application: AuthorizedOpenResponsesApplicationRequest,
+): Promise<AdmittedOpenResponsesApplicationRequest | undefined> {
+  const { getRuntimeConfig } = await import("../config/io.js");
+  if (!application.captured.isCurrent()) {
+    return undefined;
+  }
+  const registration = application.captured.registration;
+  const cfg = getRuntimeConfig();
+  const policy = resolveOpenResponsesApplicationPolicy({
+    cfg,
+    policyRef: application.principal.policyRef,
+    expectedRevision: application.principal.policyRevision,
+    integration: {
+      pluginId: registration.pluginId,
+      ...(registration.pluginVersion ? { pluginVersion: registration.pluginVersion } : {}),
+    },
+  });
+  if (!policy || !application.captured.isCurrent()) {
+    return undefined;
+  }
+  const profile = ensureProfileForApplicationPrincipal({
+    pluginId: registration.pluginId,
+    subject: application.principal.subject,
+    displayName: `${registration.pluginId} application`,
+  });
+  return {
+    ...application,
+    policy,
+    requestAuth: {
+      trustDeclaredOperatorScopes: false,
+      authenticatedUserProfile: {
+        profileId: profile.id,
+        displayName: profile.displayName,
+        hasAvatar: Boolean(profile.avatarMime),
+        updatedAt: profile.updatedAt,
+      },
+      operatorRolePolicy: policy.role,
+      applicationPrincipal: {
+        pluginId: registration.pluginId,
+        subject: application.principal.subject,
+        profileId: profile.id,
+        agentId: policy.agentId,
+        policyRef: application.principal.policyRef,
+        policyRevision: application.principal.policyRevision,
+      },
+    },
+  };
+}
