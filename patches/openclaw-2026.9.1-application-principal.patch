diff --git a/src/gateway/openresponses-application-policy.ts b/src/gateway/openresponses-application-policy.ts
new file mode 100644
index 0000000..2a06fa5
--- /dev/null
+++ b/src/gateway/openresponses-application-policy.ts
@@ -0,0 +1,108 @@
+import { createHash } from "node:crypto";
+import { stableStringify } from "@openclaw/normalization-core";
+import { resolveAgentConfig, resolveAgentEntry } from "../agents/agent-scope-config.js";
+import type { GatewayOperatorRoleDefinition } from "../config/types.gateway.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import { VERSION } from "../version.js";
+
+export type OpenResponsesApplicationPolicyIntegration = {
+  pluginId: string;
+  pluginVersion?: string;
+};
+
+/** Host-owned immutable effective ceiling consumed by one admitted native run. */
+export type ResolvedOpenResponsesApplicationPolicy = {
+  agentId: string;
+  config: OpenClawConfig;
+  role: GatewayOperatorRoleDefinition;
+  revision: string;
+};
+
+function getOwnRole(
+  cfg: OpenClawConfig,
+  policyRef: string,
+): GatewayOperatorRoleDefinition | undefined {
+  const definitions = cfg.gateway?.roles?.definitions;
+  return definitions && Object.hasOwn(definitions, policyRef) ? definitions[policyRef] : undefined;
+}
+
+function resolveDedicatedPolicy(params: {
+  cfg: OpenClawConfig;
+  policyRef: string;
+}): { agentId: string; role: GatewayOperatorRoleDefinition } | undefined {
+  const role = getOwnRole(params.cfg, params.policyRef);
+  if (
+    !role ||
+    role.sessions.others !== "none" ||
+    role.agents === "*" ||
+    role.agents.length !== 1 ||
+    role.scopes.includes("operator.admin")
+  ) {
+    return undefined;
+  }
+  const agentId = role.agents[0]!;
+  return resolveAgentEntry(params.cfg, agentId) && resolveAgentConfig(params.cfg, agentId)
+    ? { agentId, role }
+    : undefined;
+}
+
+function policyRevisionPayload(
+  cfg: OpenClawConfig,
+  policyRef: string,
+  agentId: string,
+  role: GatewayOperatorRoleDefinition,
+  integration: OpenResponsesApplicationPolicyIntegration,
+) {
+  return {
+    version: 2,
+    runtimeVersion: VERSION,
+    integration,
+    policyRef,
+    agentId,
+    role,
+    agentEntry: resolveAgentEntry(cfg, agentId) ?? null,
+    resolvedAgent: resolveAgentConfig(cfg, agentId) ?? null,
+    agentDefaults: cfg.agents?.defaults ?? null,
+    tools: cfg.tools ?? null,
+  };
+}
+
+/**
+ * Revisions one closed, single-agent host policy without interpreting a plugin's
+ * consent vocabulary or deployment recipe. The registering plugin decides which
+ * such policies it is willing to offer; core executes the exact resolved snapshot.
+ */
+export function fingerprintOpenResponsesApplicationPolicy(
+  cfg: OpenClawConfig,
+  policyRef: string,
+  integration: OpenResponsesApplicationPolicyIntegration,
+): string | undefined {
+  const resolved = resolveDedicatedPolicy({ cfg, policyRef });
+  if (!resolved) {
+    return undefined;
+  }
+  return `sha256:${createHash("sha256")
+    .update(
+      stableStringify(
+        policyRevisionPayload(cfg, policyRef, resolved.agentId, resolved.role, integration),
+      ),
+    )
+    .digest("base64url")}`;
+}
+
+export function resolveOpenResponsesApplicationPolicy(params: {
+  cfg: OpenClawConfig;
+  policyRef: string;
+  expectedRevision: string;
+  integration: OpenResponsesApplicationPolicyIntegration;
+}): ResolvedOpenResponsesApplicationPolicy | undefined {
+  const resolved = resolveDedicatedPolicy(params);
+  const revision = fingerprintOpenResponsesApplicationPolicy(
+    params.cfg,
+    params.policyRef,
+    params.integration,
+  );
+  return resolved && revision === params.expectedRevision
+    ? { ...resolved, config: params.cfg, revision }
+    : undefined;
+}
