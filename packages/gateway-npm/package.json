{
  "name": "@open-agent-connect/gateway",
  "version": "0.1.0-alpha.1",
  "description": "User-owned ACP gateway with container-isolated agent sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jomi-se/agent-connect.git",
    "directory": "packages/gateway-npm"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "type": "module",
  "bin": {
    "agent-connect": "bin/gateway.mjs",
    "agent-connect-gateway": "bin/gateway.mjs"
  },
  "files": [
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "agentConnect": {
    "adapterVersions": {
      "@agentclientprotocol/codex-acp": "2.0.1",
      "@agentclientprotocol/claude-agent-acp": "0.84.0",
      "@openai/codex": "0.159.2",
      "@anthropic-ai/claude-code": "2.1.286"
    }
  },
  "optionalDependencies": {
    "@open-agent-connect/gateway-darwin-arm64": "0.1.0-alpha.1",
    "@open-agent-connect/gateway-linux-x64": "0.1.0-alpha.1",
    "@open-agent-connect/gateway-linux-arm64": "0.1.0-alpha.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
