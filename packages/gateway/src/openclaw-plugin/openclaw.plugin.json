{
  "id": "agent-connect-openclaw",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "issuer",
      "resource",
      "statePath",
      "ownerProfileIds",
      "policies"
    ],
    "properties": {
      "issuer": { "type": "string", "format": "uri" },
      "resource": { "type": "string", "format": "uri" },
      "statePath": { "type": "string", "minLength": 1 },
      "ownerProfileIds": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "policies": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "label", "agentId", "nativeCapabilities"],
          "properties": {
            "ref": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "label": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "description": { "type": "string", "maxLength": 1024 },
            "agentId": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "nativeCapabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["public_web_search", "sandbox_code_execution"]
              }
            }
          }
        }
      }
    }
  }
}
