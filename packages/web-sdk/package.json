{
  "name": "@open-agent-connect/web",
  "version": "0.0.10",
  "description": "Browser ACP SDK for lending application tools to user-owned agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jomi-se/agent-connect.git",
    "directory": "packages/web-sdk"
  },
  "homepage": "https://github.com/jomi-se/agent-connect/tree/main/packages/web-sdk#readme",
  "type": "module",
  "sideEffects": [
    "./dist/zod-jitless.js"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-web-sdk.mjs",
    "prepack": "npm run build",
    "test": "vitest run test",
    "test:webmcp": "playwright test --config playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@cfworker/json-schema": "4.1.1",
    "ai": "7.0.118",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "@ai-sdk/react": "4.0.121",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agent-connect",
    "acp",
    "user-owned-agents",
    "application-tools",
    "browser-sdk",
    "experimental"
  ],
  "bugs": {
    "url": "https://github.com/jomi-se/agent-connect/issues"
  },
  "types": "./dist/index.d.ts"
}
