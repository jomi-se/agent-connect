{
  "name": "@open-agent-connect/web",
  "version": "0.1.0-alpha.1",
  "description": "Browser SDK for lending application tools to user-owned agents, with experimental ACP chat support",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jomi-se/agent-connect.git",
    "directory": "packages/web-sdk"
  },
  "homepage": "https://github.com/jomi-se/agent-connect/tree/main/packages/web-sdk#readme",
  "type": "module",
  "sideEffects": [
    "./dist/zod-jitless.js"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./acp": {
      "types": "./dist/acp.d.ts",
      "import": "./dist/acp.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-web-sdk.mjs",
    "prepack": "npm run build",
    "test": "vitest run test",
    "test:webmcp": "playwright test --config playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@ai-sdk/open-responses": "2.0.39",
    "@cfworker/json-schema": "4.1.1",
    "ai": "7.0.93",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "6.0.2",
    "vitest": "4.1.11",
    "@ai-sdk/react": "4.0.96",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3"
  },
  "engines": {
    "node": ">=22"
  }
}
