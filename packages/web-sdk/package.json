{
  "name": "@open-agent-connect/web",
  "version": "0.0.2",
  "description": "Harness-neutral browser SDK for lending application tools to user-owned agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jomi-se/agent-connect.git",
    "directory": "packages/web-sdk"
  },
  "homepage": "https://github.com/jomi-se/agent-connect/tree/main/packages/web-sdk#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run test",
    "test:webmcp": "playwright test --config playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
