{
  "name": "@open-agent-connect/openclaw-plugin",
  "version": "0.0.2",
  "description": "Stock OpenClaw-hosted Agent Connect gateway",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jomi-se/agent-connect.git",
    "directory": "packages/openclaw-plugin"
  },
  "homepage": "https://github.com/jomi-se/agent-connect/tree/main/packages/openclaw-plugin#readme",
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": "./dist/index.mjs",
  "files": [
    "dist",
    "LICENSE",
    "openclaw.plugin.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "@openclaw/gateway-client": "2026.9.1",
    "@openclaw/gateway-protocol": "2026.9.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.9.1",
      "minGatewayVersion": "2026.9.1"
    },
    "build": {
      "openclawVersion": "2026.9.1",
      "pluginSdkVersion": "2026.9.1"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-stock-openclaw-plugin.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
