{
  "name": "@agent-connect/openclaw-plugin",
  "version": "0.1.0",
  "description": "Stock OpenClaw-hosted Agent Connect gateway",
  "license": "MIT",
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": "2026.9.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "@openclaw/gateway-client": "2026.9.1",
    "@openclaw/gateway-protocol": "2026.9.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.9.1 <2026.10.0",
      "minGatewayVersion": "2026.9.1"
    },
    "build": {
      "openclawVersion": "2026.9.1",
      "pluginSdkVersion": "2026.9.1"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-stock-openclaw-plugin.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
